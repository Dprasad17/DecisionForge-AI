# ==============================================================================
# DecisionForge AI - Environment Configuration Example
# Copy this file to .env and adjust variables as needed.
# Note: Never commit secrets or actual API keys to version control.
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=true

# Decision Engine Settings
CLASSIFIER_CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.40
ENABLE_IN_MEMORY_CACHE=true

# Optional External LLM Settings (System defaults to safe local templates if key is missing)
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TIMEOUT_SECONDS=10
